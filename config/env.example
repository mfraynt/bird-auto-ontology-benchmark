# Settings for NVIDIA/auto-ontology-eval's .env used in this benchmark.
# Copy the relevant lines into auto-ontology-eval/.env. No secrets here.

# --- Chat model: Claude Haiku 5.5 through the local LiteLLM gateway ---
DEFAULT_MODELS_ENDPOINT=http://localhost:4000/v1
DEFAULT_MODELS_MODEL=azure/anthropic/claude-haiku-5-5
# python-dotenv expands this from the shell, so the key matches LiteLLM's.
DEFAULT_MODELS_API_KEY=${LITELLM_MASTER_KEY}

# --- Control arm (NeMo Gym): same model, so the delta measures the ontology ---
GYM_MODEL=azure/anthropic/claude-haiku-5-5
GYM_MODEL_URL=http://localhost:4000/v1

# --- Embeddings: jina-embeddings-v4 via llama-server (native 2048 dims) ---
EMBED_ENDPOINT=http://localhost:8081/v1
EMBED_MODEL=jina-embeddings-v4
EMBED_API_KEY=local

# --- Reranker: bge-reranker-v2-m3 via llama-server ---
# Not in the harness's .env.example. Without it, reranking falls back to
# DEFAULT_MODELS_ENDPOINT and fails (bridge-table owner selection).
RERANK_ENDPOINT=http://localhost:8082/v1/rerank
RERANK_MODEL=bge-reranker-v2-m3
RERANK_API_KEY=local

# --- Concurrency / timeouts ---
LLM_INVOKE_TIMEOUT_S=180
SEMANTIC_LLM_MAX_INFLIGHT=4

# --- Catalog store (Auto Ontology's docker-compose Postgres) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=auto_ontology

# --- BIRD Mini-Dev SQLite databases (all 11, comma-separated) ---
CONNECTION_STRINGS=sqlite:////ABS/PATH/dev/california_schools/california_schools.sqlite,sqlite:////ABS/PATH/dev/card_games/card_games.sqlite,sqlite:////ABS/PATH/dev/codebase_community/codebase_community.sqlite,sqlite:////ABS/PATH/dev/debit_card_specializing/debit_card_specializing.sqlite,sqlite:////ABS/PATH/dev/european_football_2/european_football_2.sqlite,sqlite:////ABS/PATH/dev/financial/financial.sqlite,sqlite:////ABS/PATH/dev/formula_1/formula_1.sqlite,sqlite:////ABS/PATH/dev/student_club/student_club.sqlite,sqlite:////ABS/PATH/dev/superhero/superhero.sqlite,sqlite:////ABS/PATH/dev/thrombosis_prediction/thrombosis_prediction.sqlite,sqlite:////ABS/PATH/dev/toxicology/toxicology.sqlite
